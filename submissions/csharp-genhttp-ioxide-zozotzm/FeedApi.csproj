<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>runtime-async=on</Features>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Server GC without DATAS: the live set is the 1M idle connections, and DATAS trades throughput for heap size. -->
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GenHTTP.Engine.Ioxide" Version="11.1.0" />
    <PackageReference Include="GenHTTP.Modules.IO" Version="11.1.0" />
    <PackageReference Include="GenHTTP.Modules.Compression" Version="11.1.0" />
    <PackageReference Include="ioxide.pg" Version="0.15.251" />
  </ItemGroup>

</Project>
